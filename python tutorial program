RESET = "\033[0m" # ANSI escape codes used to format text in terminals that support them.
BOLD = "\033[1m"

CHAPTER_COLORS = { # Assign a text color to each chapter.
    1: "\033[91m",  # Red
    2: "\033[92m",  # Green
    3: "\033[93m",  # Yellow
    4: "\033[94m",  # Blue
    5: "\033[95m",  # Magenta
    6: "\033[96m",  # Cyan
    7: "\033[95m",  # Pink
}

def show_chapter(chapter_number): # Display a chapter, formatting its title and selected headings.
    color = CHAPTER_COLORS.get(chapter_number, "")
    lines = CHAPTERS[chapter_number].strip().splitlines() # Remove blank space around the lesson, then process it one line at a time.

    for index, line in enumerate(lines):
        # Bold and color the chapter title
        if index == 0:
            print(f"{BOLD}{color}{line}{RESET}")
        # Bold section headings (non-empty lines ending in "?") and (non-empty lines start in "~")
        elif line.strip() and line.strip().endswith("?"):
            print(f"{BOLD}{color}{line}{RESET}")
        elif line.strip() and line.strip().startswith("~"):
            print(f"{BOLD}{color}{line}{RESET}")
        else:
            print(line)

import random


def ask_yes_no(prompt): # Keep asking until the user enters an accepted yes or no response.
    while True:
        answer = input(prompt).strip().lower()
        if answer in ("yes", "y"):
            return True
        if answer in ("no", "n"):
            return False
        print("Please answer yes or no.")


def guess_the_number(): # Run a number-guessing game, rejecting inputs that aren't whole numbers.
    secret = random.randint(1, 20)
    guesses = 0

    print("\nI'm thinking of a number from 1 to 20.")

    while True:
        try: # Convert the user's text to an integer; ask again if conversion fails.
            guess = int(input("Guess the number: "))
        except ValueError:
            print("Please enter a whole number.")
            continue

        guesses += 1 # Count only valid whole-number guesses.

        if guess < secret:
            print("Too low!")
        elif guess > secret:
            print("Too high!")
        else:
            print(f"Correct! You guessed it in {guesses} tries.")
            break


def loop_activity(): # Ask the user to type the expected loop; this checks the text, not the code itself.
    print("\nInteractive activity: Write a loop that prints numbers 5 to 1.")
    print("Enter one line of Python code:")

    code = input("Your code: ").strip()

    if code == "for number in range(5, 0, -1):": # Ask the user to type the expected loop; this checks the text, not the code itself.
        print("Correct! That loop runs five times.")
        for number in range(5, 0, -1):
            print(number)
    else:
        print("That isn't the expected loop. Here's one way to do it:")
        for number in range(5, 0, -1):
            print(number)


def run_activities(): # Offer Chapter 7's activities, then return whether to show the menu again.
    if ask_yes_no("\nWould you like to do the interactive activity? (yes/no): "):
        guess_the_number()

        if ask_yes_no("\nWould you like to do the second activity, loop activity? (yes/no): "):
            loop_activity()

    # This is asked whether they did the activities or skipped them.
    if ask_yes_no("\nWould you like to choose another chapter? (yes/no): "):
        print("Returning to the chapter menu...")
        return True
    else:
        print("Good luck With Your Studies!")
